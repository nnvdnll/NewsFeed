@model List<NewsClientApp.Data.Source>
@{
    ViewData["Title"] = "Авторизация";
}

<h2 class="h2">Авторизация</h2>

<div asp-validation-summary="All"></div>

<form method="post">
    <div class="mb-3">
        <label for="exampleInputTitle" class="form-label">Логин</label>
        <input type="text" name="Username" class="form-control" id="exampleInputTitle" placeholder="Введите заголовок">
    </div>

    <div class="mb-3">
        <label for="exampleInputCategory" class="form-label">Пароль</label>
        <input type="text" name="Password" class="form-control" id="exampleInputCategory" placeholder="Например: Технологии">
    </div>


    <button type="submit" class="btn btn-primary">Создать</button>
</form>